#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  git quick-push [commit message]
  git quick-push -m "type(scope): subject"

Stages all changes, commits them, and pushes the current branch.
By default, Codex generates the message with gpt-5.6-luna in fast mode.
The legacy -a/--ai flag is accepted for compatibility and has no extra effect.
USAGE
}

die() {
  printf "git-quick-push: %s\n" "$*" >&2
  exit 1
}

join_args() {
  local joined=""
  local arg

  for arg in "$@"; do
    if [ -z "$joined" ]; then
      joined="$arg"
    else
      joined="$joined $arg"
    fi
  done

  printf "%s" "$joined"
}

count_changed_paths() {
  git diff --cached --name-only | wc -l | tr -d " "
}

build_ai_commit_prompt() {
  cat <<PROMPT
Write exactly one Conventional Commit subject line for the staged Git changes.

Rules:
- Output only the commit subject line.
- Use English ASCII.
- Keep it under 72 characters when practical.
- Prefer one of: feat, fix, refactor, docs, test, chore, ci, build.
- Do not use markdown, quotes, or explanations.

Changed files:
$(git diff --cached --name-status)

Diff stat:
$(git diff --cached --stat)

Patch excerpt:
$(git diff --cached --no-ext-diff --unified=2 | sed -n '1,500p')
PROMPT
}

sanitize_ai_commit_message() {
  awk '
    NF {
      gsub(/\r$/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      gsub(/^[-*]+[[:space:]]*/, "")
      gsub(/^`+|`+$/, "")
      gsub(/^"+|"+$/, "")
      print
      exit
    }
  '
}

generate_ai_commit_message() {
  local repo_root
  local message_file
  local output
  local message

  command -v codex >/dev/null 2>&1 || return 1
  repo_root="$(git rev-parse --show-toplevel)"
  message_file="$(git rev-parse --absolute-git-dir)/git-quick-push-message.$$"
  : > "$message_file" || return 1

  if ! build_ai_commit_prompt | codex exec \
    -m "$ai_model" \
    -c "service_tier=\"$ai_service_tier\"" \
    -c 'approval_policy="never"' \
    --sandbox read-only \
    --ephemeral \
    --color never \
    -o "$message_file" \
    -C "$repo_root" \
    - >/dev/null 2>/dev/null; then
    rm -f "$message_file"
    return 1
  fi

  output="$(sed -n '1,20p' "$message_file" 2>/dev/null || true)"
  rm -f "$message_file"

  message="$(printf "%s\n" "$output" | sanitize_ai_commit_message)"
  [ -n "$message" ] || return 1
  printf "%s" "$message"
}

push_current_branch() {
  local branch="$1"

  if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
    git push
    return
  fi

  if git remote get-url origin >/dev/null 2>&1; then
    git push -u origin "$branch"
    return
  fi

  die "当前分支没有 upstream，也没有 origin remote，无法自动 push"
}

commit_message=""
ai_model="${GIT_QUICK_PUSH_AI_MODEL:-gpt-5.6-luna}"
ai_service_tier="${GIT_QUICK_PUSH_AI_SERVICE_TIER:-fast}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -a|--ai)
      shift
      ;;
    -m|--message)
      shift
      [ "$#" -gt 0 ] || die "-m/--message 需要提交信息"
      commit_message="$1"
      shift
      ;;
    --)
      shift
      if [ "$#" -gt 0 ] && [ -z "$commit_message" ]; then
        commit_message="$(join_args "$@")"
      fi
      break
      ;;
    -*)
      die "未知参数：$1"
      ;;
    *)
      if [ -z "$commit_message" ]; then
        commit_message="$(join_args "$@")"
      fi
      break
      ;;
  esac
done

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "当前目录不在 Git 仓库内"

git_dir="$(git rev-parse --git-dir)"
if [ -f "$git_dir/MERGE_HEAD" ] || [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
  die "当前仓库有未完成的 merge/rebase，请先处理后再 quick-push"
fi

branch="$(git symbolic-ref --quiet --short HEAD)" || die "当前处于 detached HEAD，无法判断要推送的分支"

if [ -z "$(git status --porcelain)" ]; then
  printf "没有可提交内容，尝试推送当前分支 %s。\n" "$branch"
  push_current_branch "$branch"
  exit 0
fi

git add -A

if git diff --cached --quiet; then
  printf "没有可提交内容，尝试推送当前分支 %s。\n" "$branch"
  push_current_branch "$branch"
  exit 0
fi

changed_count="$(count_changed_paths)"

if [ -z "$commit_message" ]; then
  if ! commit_message="$(generate_ai_commit_message)"; then
    die "Codex 无法使用 ${ai_model}（${ai_service_tier}）生成提交信息；未执行 commit/push"
  fi
fi

printf "提交 %s 个路径：%s\n" "$changed_count" "$commit_message"
git commit -m "$commit_message" -m "$(git diff --cached --name-only | sed 's/^/- /')"
push_current_branch "$branch"
